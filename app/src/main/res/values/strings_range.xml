    <string name="range_reject_inconsistent">The two sights point at different things. Retake sight 2 on the same point.</string>
    <string name="range_reject_too_uncertain">Not accurate enough yet. Walk further sideways and retake sight 2.</string>
    <string name="range_reject_invalid">Something went wrong. Start over.</string>
    <string name="range_sight_not_steady">Couldn\'t hold the aim steady. Try again.</string>
    <string name="range_sight_not_tracking">Tracking lost. Move slowly and try again.</string>


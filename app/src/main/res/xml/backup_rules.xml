<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Keep in sync with data_extraction_rules.xml (ProPersistenceTest checks both).
     Only settings are backed up; gallery items (database + GLB/JPEG files, which must be restored
     together) are not. -->
<full-backup-content>
    <include domain="file" path="datastore/" />
    <!-- Calibration is specific to this phone (its camera/IMU): never restore it onto another device. -->
    <exclude domain="file" path="datastore/spaceview_measure.preferences_pb" />
    <!-- Pro entitlement cache: a restore must never grant Pro on another phone or account (R4b). Play is
         asked again on first start, so a real subscriber gets Pro back through Restore / the start query. -->
    <exclude domain="file" path="datastore/spaceview_entitlement.preferences_pb" />
</full-backup-content>

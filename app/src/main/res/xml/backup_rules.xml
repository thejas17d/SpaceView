<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Only settings are backed up for now; whether gallery items
     (database + GLB/JPEG files, which must be restored together) join them is decided in M3. -->
<full-backup-content>
    <include domain="file" path="datastore/" />
    <!-- Calibration is specific to this phone (its camera/IMU): never restore it onto another device. -->
    <exclude domain="file" path="datastore/spaceview_measure.preferences_pb" />
</full-backup-content>

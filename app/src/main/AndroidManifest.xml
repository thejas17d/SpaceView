<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera is the only runtime (dangerous) permission. It is requested when the user opens
         Measure or Scan. Everything else below is a normal install-time permission for ads;
         ci/allowed-permissions.txt must match the merged release manifest. -->
    <!-- The camera is genuinely required (AR Required), so lint's ChromeOS advice to mark the
         implied camera feature optional does not apply. -->
    <uses-permission
        android:name="android.permission.CAMERA"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />

    <!-- AdMob + UMP consent (M5). Keep ci/allowed-permissions.txt in sync with the merged manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Merged in by SceneView (haptics). SpaceView avoids vibration during AR (it disturbs
         tracking), so it is stripped. -->
    <uses-permission
        android:name="android.permission.VIBRATE"
        tools:node="remove" />

    <!-- Merged in by androidx.work:work-runtime 2.7.0, which play-services-ads 25.5.0 pulls in for
         two plain background Workers (OfflinePingSender, OfflineNotificationPoster). Checked in the
         bytecode (M2 review minor 13): neither the ads SDK nor UMP calls setForegroundAsync, uses
         ForegroundInfo or enqueues expedited work, so WorkManager never starts its
         SystemForegroundService and the permission is unused. Removing it also avoids Play's
         foreground-service type declaration (targetSdk 34+). Re-check when play-services-ads or
         work-runtime changes version (ci/release-dependencies.txt flags that). -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!-- Merged in by work-runtime and play-services-measurement-sdk-api. Its only users in the
         release dex: WorkManager's foreground path (unused, see above), its SystemAlarmService path
         (API 22 and lower only; minSdk is 24, so JobScheduler is used) and the ads SDK's video
         player wake lock, which checks the permission first and plays without a CPU wake lock when
         it is missing. Nothing acquires it unconditionally, so it is stripped. -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <!-- AR Required: Play lists the app only on ARCore-certified devices and installs
         Google Play Services for AR together with it. -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="true" />

    <application
        android:name=".SpaceViewApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.SpaceView"
        tools:targetApi="36">

        <!-- SceneView's library manifest declares "optional"; SpaceView v1 is AR Required. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="required"
            tools:replace="android:value" />

        <!-- AdMob app ID: Google's test ID in debug, ADMOB_APP_ID in release (app/build.gradle.kts). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- Defaults since 24.0.0; stated explicitly so a downgrade cannot slow start-up. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <!-- Share sheet (M3 gallery): read-only content:// URIs for files/gallery/ and cache/share/ only,
             granted per share intent. Not exported; needs no permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
